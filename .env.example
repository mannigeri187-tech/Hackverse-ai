# =========================================================
# HACKVERSE AI — ENVIRONMENT VARIABLES EXAMPLE
# =========================================================

# CLIENT-SAFE VARIABLES (Exposed to browser via Vite bundle)
# ---------------------------------------------------------
# [REQUIRED] Supabase Public URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# [REQUIRED] Supabase Anonymous Public Key (Safe for client, guarded by RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key


# SERVER-ONLY SECRETS (NEVER exposed to frontend / client bundle)
# ---------------------------------------------------------
# [REQUIRED] Supabase Service Role Key (Used only by serverless backend / admin scripts)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# [REQUIRED] Google Gemini Generative AI API Key
GEMINI_API_KEY=your_gemini_api_key

# [OPTIONAL] Resend API Key for custom transactional emails
RESEND_API_KEY=your_resend_api_key

# [OPTIONAL] Redis connection URL (if caching server enabled)
REDIS_URL=redis://default:password@your-redis-host:6379
