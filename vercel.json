{
    "functions":  {
                      "api/**/*.js":  {
                                          "memory":  1024,
                                          "maxDuration":  60
                                      }
                  },
    "rewrites":  [
                     {
                         "source":  "/api/(.*)",
                         "destination":  "/api/$1"
                     },
                     {
                         "source":  "/(.*)",
                         "destination":  "/index.html"
                     }
                 ],
    "crons":  [
                  {
                      "path":  "/api/hackathons/cron?task=ingest",
                      "schedule":  "0 0 * * *"
                  },
                  {
                      "path":  "/api/hackathons/cron?task=validate-links",
                      "schedule":  "0 0 * * *"
                  }
              ],
    "headers":  [
                    {
                        "headers":  [
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "DENY"
                                        },
                                        {
                                            "key":  "X-XSS-Protection",
                                            "value":  "1; mode=block"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "strict-origin-when-cross-origin"
                                        },
                                        {
                                            "key":  "Strict-Transport-Security",
                                            "value":  "max-age=31536000; includeSubDomains; preload"
                                        },
                                        {
                                            "key":  "Permissions-Policy",
                                            "value":  "camera=(), microphone=(), geolocation=(), browsing-topics=()"
                                        }
                                    ],
                        "source":  "/(.*)"
                    }
                ]
}
